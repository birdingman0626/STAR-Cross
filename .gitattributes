# Store text with LF in the repository; checkouts follow the user's core.autocrlf.
* text=auto
# Executable Unix scripts must survive Windows checkouts without CRLF.
*.sh text eol=lf
# The patch queue hashes raw bytes and must be identical on every checkout.
source/cmake/htslib-patches/* text eol=lf
# Vendored test fixtures that deliberately contain CRLF / mixed endings.
source/htslib/test/** -text
source/SimpleGoodTuring/ReadMe.txt -text
